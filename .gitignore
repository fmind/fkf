# Build artifacts. `go build ./cmd/fkf` from the root writes ./fkf; mise writes bin/fkf.
/bin/
/dist/
/fkf
/coverage.out

# Machine-local: a developer's exported credentials, agent scratch space, prompts, plans, and
# local skills. Contributor skills under .agents/skills/ stay versioned.
/.env
/.agents/AGENTS.md
/.agents/PLAN.md
/.agents/tmp/
/.agents/prompts/
/.agents/skills/local-*/

.DS_Store
__pycache__/
*.pyc
/.ruff_cache/
