# Generated package and coverage artifacts.
/dist/
/.coverage
/.cache/
/.pytest_cache/
/.opengrep/
/coverage.out
/.venv/
/htmlcov/
*.egg-info/

# Preserve developer-local binaries from pre-v5 checkouts without shipping them.
/bin/
/fkf

# Machine-local: a developer's exported credentials, agent scratch space, prompts, plans, and
# local skills. Contributor skills under .agents/skills/ stay versioned.
/.env
/.agents/AGENTS.md
/.agents/PLAN.md
/.agents/tmp/
/.agents/prompts/
/.agents/skills/local-*/

.DS_Store
__pycache__/
*.pyc
/.ruff_cache/
/site/
/.ty/
