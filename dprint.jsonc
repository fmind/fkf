{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "markdown": {
    "textWrap": "never"
  },
  // Source fixtures under services/testdata/sources/ carry a real, semantic constraint some
  // presets rely on: an ndjson-format source needs the whole fixture as ONE physical line, so
  // sources.DecodeRecords splits it the same way it would split a real CLI's stdout. Pretty-
  // printing one across many lines is not a style choice here — it silently breaks what the
  // fixture is testing, which is why this directory is exempt rather than reformatted.
  "excludes": ["services/testdata/sources/**"],
  "plugins": [
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ]
}
