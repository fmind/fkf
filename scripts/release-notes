#!/bin/sh
# Print exactly one tagged section from CHANGELOG.md for GoReleaser/GitHub.
set -eu

tag=${1:?usage: release-notes <tag> [changelog]}
changelog=${2:-CHANGELOG.md}

awk -v prefix="## [${tag}]" '
  index($0, prefix) == 1 { found = 1; next }
  found && /^## \[/ { exit }
  found { print }
  END {
    if (!found) {
      print "release-notes: no section for " substr(prefix, 4) > "/dev/stderr"
      exit 1
    }
  }
' "${changelog}"
